{
  "title": "VIN Share - Segurança e Operação",
  "uid": "vinshare-sec",
  "schemaVersion": 39,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "tags": ["vinshare", "security"],
  "panels": [
    { "id": 1, "type": "timeseries", "title": "Tentativas de login (sucesso, falha, bloqueio)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 8 },
      "targets": [
        { "refId": "A", "expr": "sum by (result) (increase(vinshare_auth_login_total[5m]))", "legendFormat": "{{result}}" },
        { "refId": "B", "expr": "sum(increase(vinshare_rate_limited_total{scope=~\"login.*\"}[5m]))", "legendFormat": "bloqueado (rate limit)" }
      ] },
    { "id": 2, "type": "timeseries", "title": "Requisições por status HTTP",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 8 },
      "targets": [{ "refId": "A", "expr": "sum by (status) (increase(vinshare_http_requests_total[5m]))", "legendFormat": "{{status}}" }] },
    { "id": 3, "type": "timeseries", "title": "Latência p95 da API (s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 8 },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(vinshare_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95" }] },
    { "id": 4, "type": "timeseries", "title": "Acessos negados (403 / escopo de concessionária)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 8, "w": 8, "h": 8 },
      "targets": [{ "refId": "A", "expr": "sum by (permission) (increase(vinshare_authz_denied_total[5m]))", "legendFormat": "{{permission}}" }] },
    { "id": 5, "type": "timeseries", "title": "JWT rejeitados por motivo",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 8, "y": 8, "w": 8, "h": 8 },
      "targets": [{ "refId": "A", "expr": "sum by (reason) (increase(vinshare_auth_token_rejected_total[5m]))", "legendFormat": "{{reason}}" }] },
    { "id": 6, "type": "barchart", "title": "Predições de churn por faixa de risco",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 16, "y": 8, "w": 8, "h": 8 },
      "targets": [{ "refId": "A", "expr": "sum by (risk) (increase(vinshare_ml_predictions_total[1h]))", "legendFormat": "{{risk}}" }] },
    { "id": 7, "type": "timeseries", "title": "Telemetria IoT: aceitas x rejeitadas por motivo",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 16, "w": 8, "h": 8 },
      "targets": [{ "refId": "A", "expr": "sum by (result) (increase(vinshare_iot_messages_total[5m]))", "legendFormat": "{{result}}" }] },
    { "id": 8, "type": "timeseries", "title": "App mobile: requisições por versão",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 8, "y": 16, "w": 8, "h": 8 },
      "targets": [{ "refId": "A", "expr": "sum by (app_version, result) (increase(vinshare_mobile_requests_total[5m]))", "legendFormat": "{{app_version}} ({{result}})" }] },
    { "id": 9, "type": "heatmap", "title": "Distribuição do score de churn (drift)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 16, "y": 16, "w": 8, "h": 8 },
      "targets": [{ "refId": "A", "expr": "sum by (le) (increase(vinshare_ml_churn_score_bucket[10m]))", "format": "heatmap", "legendFormat": "{{le}}" }] },
    { "id": 10, "type": "logs", "title": "Eventos de auditoria (Loki)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "x": 0, "y": 24, "w": 24, "h": 9 },
      "targets": [{ "refId": "A", "expr": "{service=~\"api|ingestion\"} | json | event=~\"auth.*|authz.*|lead.*|iot.telemetry.rejected\"" }] }
  ]
}
